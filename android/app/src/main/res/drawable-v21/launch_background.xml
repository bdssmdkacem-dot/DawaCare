<?xml version="1.0" encoding="utf-8"?>
<!-- DawaCare branded native launch screen. flutter_launcher_icons generates ic_launcher from assets/images/branding/dawacare_icon_1024.png before Android build. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/dawacare_teal" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
